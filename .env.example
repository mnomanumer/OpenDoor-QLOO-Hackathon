# Qloo Agentic Hackathon API Configuration
# To use live Qloo discovery, copy this file to .env.local and enter your key:
# copy .env.example .env.local

# Your personal hackathon-provided Qloo API Key
QLOO_API_KEY=replace_with_your_qloo_api_key

# Qloo API Base URL (defaults to hackathon environment)
QLOO_BASE_URL=https://hackathon.api.qloo.com
